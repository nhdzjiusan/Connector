<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>PeripheralPower</AssemblyName>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <Product>外设电量</Product>
    <Version>1.2.1</Version>
    <SatelliteResourceLanguages>zh-Hans;zh-Hant</SatelliteResourceLanguages>
    <FileVersion>$(Version).0</FileVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <Company>Connector contributors</Company>
    <Copyright>Copyright © 2026 Connector contributors</Copyright>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PeripheralPower.Check" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <EmbeddedResource Include="HidSharp-LICENSE.txt" />
    <EmbeddedResource Include="HidRules/default-rules.json" LogicalName="PeripheralPower.HidRules.Defaults" />
    <EmbeddedResource Include="../NOTICE" Link="NOTICE" />
  </ItemGroup>
</Project>
